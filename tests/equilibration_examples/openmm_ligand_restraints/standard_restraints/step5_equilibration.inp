# Adapted from CHARMM-GUI
# NPgT SCHEME for OpenMM - template step6.5_equilibration.inp

nstep       = 500000                               # number of steps to run
dt          = 0.002                                  # time-step (ps)

nstout      = 1000                                  # Writing output frequency (steps)
nstdcd      = 5000                              # Writing coordinates trajectory frequency (steps)

coulomb     = PME                                   # Electrostatic cut-off method
ewald_Tol   = 0.0005                                # Ewald error tolerance
vdw         = CutoffPeriodic                        # vdW cut-off method
lj_lrc      = yes
r_off       = 0.9                                   # Switch-off distance (nm)

temp        = 310.15                         # Temperature (K)
fric_coeff  = 1                                     # Friction coefficient for Langevin dynamics
pcouple     = yes                                   # Turn on/off pressure coupling
p_ref       = 1.0000                                   # Pressure (bar)
p_type      = membrane                              # MonteCarloBarostat type
p_XYMode    = XYIsotropic                           # For MonteCarloMembraneBarostat
p_ZMode     = ZFree                                 # For MonteCarloMembraneBarostat
p_tens      = 0.0000                                     # Surface tension for MonteCarloMembraneBarostat (dyne/cm)
p_freq      = 15                                    # Pressure coupling frequency (steps; soft pack)

cons        = HBonds                                # Constraints method

rest        = yes                                # Turn on/off restraints
fc_bb       = 418.4000                                 # Positional restraint force constant for protein backbone (kJ/mol/nm^2)
fc_sc       = 0.0000                                  # Positional restraint force constant for protein side-chain (kJ/mol/nm^2)
fc_lpos     = 0.0000                                  # Positional restraint force constant for lipids (kJ/mol/nm^2)
fc_ldih     = 0                                     # Lipid dihedral restraints: disabled in GateWizard
