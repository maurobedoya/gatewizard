Minimization input file in explicit solvent
 &cntrl
    ! Generated by GateWizard v{GW_VERSION} on {GW_GENERATED_ON}
    ! Templates version: v1 (27 Jul 2026)
    ! Adapted from CHARMM-GUI
    ! NVT SCHEME for Amber - template step0_minimization.mdin
    imin=1,        ! Turn on minimization
    maxcyc={MAXCYC}, ! Maximum number of minimization cycles
    ncyc={NCYC},   ! Steepest-descent steps before conjugate gradient

    ! Potential energy function options
    cut=9.0,       ! nonbonded cutoff, in angstroms

    ! Control how often information is printed to the output file
    ntpr=50,       ! Print energies every 50 steps (mdinfo updates each ntpr)
    ntxo=2,        ! Write NetCDF format

    ! Restraint options
    ntr={NTR},     ! Positional restraints for proteins, sugars, ligands, and lipid head groups

    ! Set water atom/residue names for SETTLE recognition
    watnam='WAT',  ! Water residues are named WAT
    owtnm='O',     ! Water oxygens are named O
 /
{RESTRAINT_BLOCK}
